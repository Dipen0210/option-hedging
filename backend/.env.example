# OptionQ backend configuration — copy to backend/.env and fill in.
# Never commit the filled-in file: .env is gitignored for a reason.

# ── Administrative access (REQUIRED in production) ───────────────────────────
# Both are bearer tokens of at least 16 characters. A shorter or blank value is
# treated as NOT CONFIGURED, and the guarded routes then answer 503 rather than
# serving themselves unauthenticated. With ENVIRONMENT=production the server
# refuses to start until both are set.
#   Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ADMIN_API_KEY guards every /admin/* route (training logs, manual retrain,
# hedge trigger checks, earnings lookups).
ADMIN_API_KEY=
# CRON_SECRET guards /admin/cron/retrain-* only, so the scheduler's credential
# does not unlock the rest of the admin surface.
CRON_SECRET=

# ── LLM explainer ────────────────────────────────────────────────────────────
# Which provider writes the narratives. Optional in the sense that the pipeline
# runs without any of them: every number in the response is computed by the
# backend, and with no provider reachable the response carries deterministic
# text plus a notice saying the model was not called. Nothing is estimated to
# fill a gap.
#
#   vertex       Gemini over Vertex AI, authenticated with IAM. The deployed
#                choice, and the only one with no secret to store: in Cloud Run
#                the attached service account is the credential.
#   gemini       the same models over the Generative Language REST API,
#                authenticated with a long-lived API key
#   claude       Anthropic
#   huggingface  HF Inference API
#   ollama       a local Ollama server
#
# An unrecognised value falls back to `claude` and logs an error saying so.
LLM_PROVIDER=vertex

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Google Gemini, used when LLM_PROVIDER=gemini. The key is an API key from a
# GCP project with generativelanguage.googleapis.com enabled; restrict it to
# that one API. GEMINI_MODEL must name an exact stable model — not a `-preview`
# build and not a `-latest` alias. See the comment in backend/config/settings.py
# for how the default was measured; note that gemini-2.5-* are retired for new
# projects and answer 404.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Gemini over Vertex AI, used when LLM_PROVIDER=vertex. This is the
# configured provider, and it has no API key: authentication is IAM.
#
#   locally   gcloud auth application-default login
#             gcloud services enable aiplatform.googleapis.com --project <id>
#   deployed  attach a service account with roles/aiplatform.user; nothing
#             else to configure, and no secret to mount
#
# VERTEX_LOCATION must stay `global` for the 3.x models — the regional
# endpoints answer them with 404. The project needs billing enabled; Vertex
# has no free tier.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash

# HuggingFace, used when LLM_PROVIDER=huggingface
HF_API_TOKEN=

# ── Market data ──────────────────────────────────────────────────────────────
# FRED supplies the risk-free rate. Without it the rate falls back to a
# disclosed source and the response is marked degraded.
FRED_API_KEY=
NEWS_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# "development" logs configuration gaps and starts anyway; "production"
# refuses to start with any gap.
ENVIRONMENT=development
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API. Credentialed
# requests are enabled, so this is never wildcarded — there is no value here
# that means "any origin", and `*` is rejected by test_security.py. In
# production every entry must be HTTPS and none may be localhost; the server
# refuses to start otherwise.
#
# Deploying on Vercel: the production domain is stable, but every preview
# deployment gets its own origin (optionq-<hash>-<scope>.vercel.app). Those
# origins are not in this list, so a preview build will fail its preflight
# against this API. That is the intended behaviour rather than a bug to work
# around — the alternative is a pattern broad enough to admit any
# `*.vercel.app`, including someone else's project. Test previews against a
# separately deployed backend, or add the specific preview origin while it is
# in use.
FRONTEND_URL=http://localhost:3000
