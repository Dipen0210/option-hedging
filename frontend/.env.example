# OptionQ frontend configuration — copy to frontend/.env.local for local work.
#
# Everything here is PUBLIC. Next.js inlines every NEXT_PUBLIC_* value into the
# JavaScript it ships to the browser, so a variable named this way is readable
# by anyone who loads the page. No credential belongs in this file, and CI
# fails the build if a NEXT_PUBLIC_ name contains KEY, SECRET, TOKEN, PASSWORD
# or CREDENTIAL (see .github/workflows/ci.yml).

# Origin of the OptionQ backend.
#
# Read at BUILD time, not at run time: `output: "export"` in next.config.ts
# produces static HTML with this value already baked into the bundle, so
# changing it means rebuilding and redeploying, not restarting anything. On
# Vercel, set it in the project's environment variables for each environment
# before the build runs.
#
#   local       http://localhost:8000
#   deployed    https://<cloud-run-service>-<hash>.<region>.run.app
#
# Whatever origin is set here must also appear in the backend's FRONTEND_URL,
# or the browser's preflight will be refused: the API sends credentialed CORS
# responses and therefore cannot answer a wildcard origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
