# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.whl

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath

# Agent / AI tooling
.agent/
.gemini/

# OS
.DS_Store
Thumbs.db
Desktop.ini
._*

# Logs
logs/
*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Streamlit
.streamlit/secrets.toml
.streamlit/cache/

# Data (keep processed, ignore raw downloads)
data/raw/
data/external/

# Secrets
.env
.env.local
.env.*.local

# ML models (binary artifacts)
backend/ml_models/*.pkl
backend/ml_models/*.joblib

# SQLite cache
backend/hedgeos_cache.db

# Next.js build output
frontend/.next/
frontend/node_modules/

# Coverage
.coverage
.coverage.*
htmlcov/

# SQLite cache — the path is resolved at runtime (OPTIONQ_CACHE_DB), so match
# the files rather than one location. These were being shipped in the Docker
# image until .dockerignore caught them; see REPAIR_REPORT.md §B⑥(b).
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# Per-machine training timestamps. They describe local *.pkl artifacts, which
# are themselves ignored above, so tracking them only produces diff noise.
backend/ml_models/*_trained_at.txt

# Frontend verification screenshots, written to the repo root by the
# browser-driven end-to-end run. They are evidence of one run on one machine at
# one moment — the findings they support live in REPAIR_REPORT.md — so tracking
# them adds megabytes of binary diff that nothing reads. Root-anchored on
# purpose: frontend/ image assets are real source.
/[0-9][0-9]-*.png
